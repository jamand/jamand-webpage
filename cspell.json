{
  "version": "0.2",
  "language": "en",
  "import": ["@cspell/dict-de-de/cspell-ext.json"],
  "words": [
    "Amand",
    "Amazonbot",
    "Blogposts",
    "Bytespider",
    "Cloudanbieter",
    "Hochscrollen",
    "Jérémy",
    "STACKIT",
    "astro",
    "astrojs",
    "bioinformatics",
    "daisyui",
    "frontmatter",
    "giscus",
    "unsplash",
    "hreflang",
    "lucide",
    "nginx",
    "tailwindcss"
  ],
  "ignorePaths": ["node_modules", "dist", ".astro", "pnpm-lock.yaml"],
  "enableFiletypes": ["mdx", "md", "astro"],
  "files": [
    "src/blog/**/*.{md,mdx}",
    "src/projects/**/*.{md,mdx}",
    "src/pages/**/*.astro"
  ],
  "overrides": [
    {
      "filename": "**/*.{md,mdx}",
      "languageSettings": [
        {
          "languageId": "markdown",
          "ignoreRegExpList": ["/^---[\\s\\S]*?^---/m"]
        }
      ]
    },
    {
      "filename": "src/blog/de/**/*.{md,mdx}",
      "language": "de,en"
    },
    {
      "filename": "src/projects/de/**/*.{md,mdx}",
      "language": "de,en"
    },
    {
      "filename": "src/pages/**/*.astro",
      "languageSettings": [
        {
          "languageId": "astro",
          "ignoreRegExpList": ["/^---[\\s\\S]*?^---/m"]
        }
      ]
    },
    {
      "filename": "src/pages/de/**/*.astro",
      "language": "de,en"
    }
  ]
}
