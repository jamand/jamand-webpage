---
// 404 Not Found page
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('404.title')} description={t('404.message')}>
	<h1>{t('404.title')}</h1>
	<p>{t('404.message')}</p>
	<a href="/">{t('common.backToHome')}</a>
</Layout>
