---
// Dynamic blog post page - renders individual posts from the blog collection (English)
import { render } from 'astro:content';
import MarkdownPostLayout from '../../layouts/MarkdownPostLayout.astro';
import {
	getAllPostSlugsForLang,
	getPostWithTranslation,
} from '../../i18n/blog-utils';

const lang = 'en';

export async function getStaticPaths() {
	const entries = await getAllPostSlugsForLang('en');
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { post: entry.post, isFallback: entry.isFallback },
	}));
}

const { post, isFallback } = Astro.props;
const { Content } = await render(post);
const { translation } = await getPostWithTranslation(post);
---

<MarkdownPostLayout
	frontmatter={post.data}
	translation={translation}
	isFallback={isFallback}
	pageLang={lang}
>
	<Content />
</MarkdownPostLayout>
