---
// Tag index page - lists all unique tags (English, with fallback)
import Layout from '../../layouts/Layout.astro';
import { getPostsWithFallback } from '../../i18n/blog-utils';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const allPosts = await getPostsWithFallback(lang);
const tags = [...new Set(allPosts.flatMap((item) => item.post.data.tags))];
---

<Layout lang={lang} description={t('meta.tags')}>
	<h1>{t('blog.tags')}</h1>
	{
		tags.length > 0 ? (
			<ul>
				{tags.map((tag) => (
					<li>
						<a href={`/tags/${tag}/`}>{tag}</a>
					</li>
				))}
			</ul>
		) : (
			<p>{t('blog.noTags')}</p>
		)
	}
</Layout>
