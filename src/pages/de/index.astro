---
// Homepage (German)
import ContentImage from '../../components/ContentImage.astro';
import Layout from '../../layouts/Layout.astro';
import BlogPostLink from '../../components/BlogPostLink.astro';
import { getPostsWithFallback, getPostUrlForLang } from '../../i18n/blog-utils';
import {
	getProjectsByLangWithFallback,
	getProjectUrl,
} from '../../i18n/project-utils';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = 'de';
const t = useTranslations(lang);

const allPosts = await getPostsWithFallback(lang);
const recentPosts = allPosts.slice(0, 3);

const projects = await getProjectsByLangWithFallback(lang);

const techStack = [
	{
		category: t('home.techStack.languages'),
		items: ['Go', 'TypeScript', 'Python', 'Bash'],
	},
	{
		category: t('home.techStack.infrastructure'),
		items: ['Kubernetes', 'Docker', 'Terraform', 'Linux'],
	},
	{ category: t('home.techStack.tools'), items: ['Git'] },
	{ category: t('home.techStack.certifications'), items: ['CKA', 'CKAD'] },
];
---

<Layout lang={lang} description={t('meta.home')}>
	<div class="not-prose space-y-16">
		{/* Hero / Intro */}
		<section class="animate-fade-in-up py-10">
			<h1 class="text-5xl font-bold">{t('home.greeting')}</h1>
			<p class="mt-3 text-2xl opacity-80">{t('home.tagline')}</p>
			<p class="mt-6 max-w-2xl text-lg">{t('home.intro')}</p>
			<div class="mt-8 flex gap-3">
				<a href={getLocalizedPath('/about/', lang)} class="btn btn-primary">
					{t('home.aboutMe')}
				</a>
				<a
					href={getLocalizedPath('/blog/', lang)}
					class="btn btn-outline btn-primary"
				>
					{t('nav.blog')}
				</a>
			</div>
		</section>

		{/* Projects */}
		<section class="animate-fade-in-up" style="animation-delay: 0.1s">
			<h2 class="mb-6 text-2xl font-bold">{t('home.projects')}</h2>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					projects.map(({ project }) => (
						<a
							href={getProjectUrl(project, lang)}
							class="card border-base-300 bg-base-100 border no-underline shadow-sm transition-all duration-200 hover:scale-[1.02] hover:shadow-lg"
						>
							<figure class="h-48 overflow-hidden">
								<ContentImage
									src={project.data.image.src}
									url={project.data.image.url}
									alt={project.data.image.alt}
									class="h-full w-full object-cover"
									loading="eager"
								/>
							</figure>
							<div class="card-body">
								<h3 class="card-title text-lg">{project.data.title}</h3>
								<p class="text-sm opacity-90">{project.data.description}</p>
								<div class="card-actions mt-2 justify-end">
									{project.data.tags.map((tag) => (
										<span class="badge badge-outline badge-sm">{tag}</span>
									))}
								</div>
							</div>
						</a>
					))
				}
			</div>
		</section>

		{/* Recent Blog Posts */}
		<section class="animate-fade-in-up" style="animation-delay: 0.2s">
			<h2 class="mb-6 text-2xl font-bold">{t('home.recentPosts')}</h2>
			{
				recentPosts.length > 0 ? (
					<>
						<ul class="space-y-1">
							{recentPosts.map((item) => (
								<BlogPostLink
									url={getPostUrlForLang(item.post, lang)}
									title={item.post.data.title}
									pubDate={item.post.data.pubDate}
									lang={lang}
									availableLanguages={item.availableLanguages}
									isFallback={item.isFallback}
								/>
							))}
						</ul>
						<a
							href={getLocalizedPath('/blog/', lang)}
							class="link mt-4 inline-block"
						>
							{t('home.viewAllPosts')}
						</a>
					</>
				) : (
					<p class="opacity-80">{t('home.noPosts')}</p>
				)
			}
		</section>

		{/* Tech Stack */}
		<section class="animate-fade-in-up" style="animation-delay: 0.3s">
			<h2 class="mb-6 text-2xl font-bold">{t('home.techStack')}</h2>
			<div class="flex flex-col gap-4">
				{
					techStack.map((group) => (
						<div>
							<h3 class="mb-2 text-sm font-semibold tracking-wide uppercase opacity-80">
								{group.category}
							</h3>
							<div class="flex flex-wrap gap-2">
								{group.items.map((tech) => (
									<span class="badge badge-soft badge-lg">{tech}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
	</div>
</Layout>
