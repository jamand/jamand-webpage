---
// Dynamic tag page - shows all posts with a specific tag (German, with fallback)
import Layout from '../../../layouts/Layout.astro';
import BlogPostLink from '../../../components/BlogPostLink.astro';
import BlogStats from '../../../components/BlogStats.astro';
import {
	getPostUrlForLang,
	type PostWithFallbackInfo,
} from '../../../i18n/blog-utils';
import { useTranslations } from '../../../i18n/utils';

const lang = 'de';
const t = useTranslations(lang);

export async function getStaticPaths() {
	const { getPostsWithFallback } = await import('../../../i18n/blog-utils');
	const allPosts = await getPostsWithFallback('de');
	const uniqueTags = [
		...new Set(allPosts.flatMap((item) => item.post.data.tags)),
	];

	return uniqueTags.map((tag) => ({
		params: { tag },
		props: {
			posts: allPosts.filter((item) => item.post.data.tags.includes(tag)),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: PostWithFallbackInfo[] };
---

<Layout lang={lang} description={`${t('blog.postsTaggedWith')} #${tag}`}>
	<h1>{t('blog.postsTaggedWith')} #{tag}</h1>
	<BlogStats posts={posts} lang={lang} />
	<ul class="not-prose space-y-1">
		{
			posts.map((item) => (
				<BlogPostLink
					url={getPostUrlForLang(item.post, lang)}
					title={item.post.data.title}
					pubDate={item.post.data.pubDate}
					lang={lang}
					availableLanguages={item.availableLanguages}
					isFallback={item.isFallback}
				/>
			))
		}
	</ul>
</Layout>
