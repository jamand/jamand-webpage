---
// Dynamic blog post page - renders individual posts from the blog collection (German)
import { render } from 'astro:content';
import MarkdownPostLayout from '../../../layouts/MarkdownPostLayout.astro';
import {
	getAllPostSlugsForLang,
	getPostWithTranslation,
	getAdjacentPosts,
} from '../../../i18n/blog-utils';

const lang = 'de';

export async function getStaticPaths() {
	const entries = await getAllPostSlugsForLang('de');
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { post: entry.post, isFallback: entry.isFallback },
	}));
}

const { post, isFallback } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { translation } = await getPostWithTranslation(post);
const { prev, next } = await getAdjacentPosts(post, lang);
---

<MarkdownPostLayout
	frontmatter={post.data}
	translation={translation}
	isFallback={isFallback}
	pageLang={lang}
	readingTime={remarkPluginFrontmatter.readingTime}
	prevPost={prev}
	nextPost={next}
>
	<Content />
</MarkdownPostLayout>
