---
// Imprint page - legal requirement for German websites
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const imprintName = import.meta.env.IMPRINT_NAME;
const imprintAddress = import.meta.env.IMPRINT_ADDRESS;
const imprintCity = import.meta.env.IMPRINT_CITY;
const imprintEmail = import.meta.env.IMPRINT_EMAIL;

const isConfigured = imprintName && imprintAddress && imprintCity;
---

<Layout lang={lang} description={t('meta.imprint')}>
	<h1>{t('imprint.title')}</h1>

	{
		isConfigured ? (
			<div class="space-y-6">
				<section>
					<h2>{t('imprint.responsible')}</h2>
					<address class="not-italic">
						<div>{imprintName}</div>
						<div>{imprintAddress}</div>
						<div>{imprintCity}</div>
					</address>
				</section>

				{imprintEmail && (
					<section>
						<h2>{t('imprint.contact')}</h2>
						<div>
							E-Mail:{' '}
							<a href={`mailto:${imprintEmail}`} class="link">
								{imprintEmail}
							</a>
						</div>
					</section>
				)}
			</div>
		) : (
			<p class="text-warning">{t('imprint.notConfigured')}</p>
		)
	}
</Layout>
