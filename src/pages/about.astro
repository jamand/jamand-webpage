---
// About page
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import type { TimelineEntry } from '../components/Timeline.astro';
import { useTranslations } from '../i18n/utils';
import ExternalLink from '../components/ExternalLink.astro';

const lang = 'en';
const t = useTranslations(lang);

const timeline: TimelineEntry[] = [
	{
		type: 'work',
		period: '2024 – present',
		title: 'Cloud Engineer',
		org: 'STACKIT GmbH & Co KG, DE',
	},
	{
		type: 'work',
		period: '2022 – 2024',
		title: 'Research Associate',
		org: 'Saarland University, DE',
	},
	{
		type: 'work',
		period: '2021 – 2022',
		title: 'Software Developer',
		org: 'DIaLOGIKa GmbH, DE',
	},
	{
		type: 'work',
		period: '2019 – 2021',
		title: 'Software Developer',
		org: 'Leoworx Ortungssysteme GmbH, DE',
	},
	{
		type: 'edu',
		period: '2017 – 2020',
		title: 'M.Sc. Bioinformatics',
		org: 'Saarland University, DE',
	},
	{
		type: 'edu',
		period: '2014 – 2017',
		title: 'B.Sc. Bioinformatics',
		org: 'Saarland University, DE',
	},
];
---

<Layout lang={lang} description={t('meta.about')}>
	<h1>About Me</h1>
	<p>
		Hello, I'm Jérémy. Welcome to my personal website. This is where I share my
		thoughts and projects. I'm originally from Luxembourg but currently living
		in Saarland, Germany. I have a degree in Bioinformatics but have ever since
		been working in IT.
	</p>
	<p>
		Currently I work at <ExternalLink href="https://stackit.com/en" class="link"
			>STACKIT</ExternalLink
		>, a genuinely European sovereign cloud provider gaining momentum. I'm a
		Cloud Engineer in the SKE team, which provides a managed Kubernetes service
		based on
		<ExternalLink href="https://gardener.cloud" class="link"
			>Gardener</ExternalLink
		>.
	</p>
	<p>
		In my free time I like to cook, although keeping things organized is a bit
		of a challenge. I like to casually play games where you don't have to read a
		whole wiki before starting and now and then I go running and cycling.
	</p>

	<h2>Short CV</h2>
	This represents a short overview of my professional career, I invite you to also
	check my
	<ExternalLink href="https://www.linkedin.com/in/jer-amand/" class="link"
		>LinkedIn profile</ExternalLink
	>.
	<div class="not-prose mt-12">
		<Timeline entries={timeline} />
	</div>
</Layout>
