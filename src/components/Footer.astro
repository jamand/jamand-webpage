---
// Footer component - displays site footer with social links
import githubIcon from '../assets/github.svg?raw';
import astroIcon from '../assets/astro.svg?raw';
import { getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/translations';
import ContentWidth from './ContentWidth.astro';
import ExternalLink from './ExternalLink.astro';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const isImprintConfigured =
	import.meta.env.IMPRINT_NAME &&
	import.meta.env.IMPRINT_ADDRESS &&
	import.meta.env.IMPRINT_CITY;
---

<footer class="footer sm:footer-horizontal bg-base-200 text-base-content p-6">
	<ContentWidth
		extraClasses="flex flex-col items-center gap-4 sm:flex-row sm:justify-between"
	>
		<nav class="flex items-center gap-4">
			<ExternalLink
				href="https://github.com/jamand"
				class="link flex items-center gap-1"
				showArrow={false}
			>
				<span class="inline-block h-5 w-5 fill-current" set:html={githubIcon} />
				GitHub
			</ExternalLink>
			<ExternalLink
				href="https://linkedin.com/in/jer-amand"
				class="link"
				showArrow={false}>LinkedIn</ExternalLink
			>
			{
				isImprintConfigured ? (
					<a href={getLocalizedPath('/impressum/', lang)} class="link">
						{t('imprint.title')}
					</a>
				) : (
					false
				)
			}
		</nav>
		<aside class="inline-flex items-center gap-1 text-sm opacity-60">
			Built from scratch with
			<span
				class="inline-block h-3.5 w-3.5 fill-current"
				set:html={astroIcon}
			/>
			<ExternalLink href="https://astro.build" class="link" showArrow={false}
				>Astro</ExternalLink
			>
		</aside>
	</ContentWidth>
</footer>
