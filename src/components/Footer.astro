---
// Footer component - displays site footer with social links
import { getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/translations';
import ContentWidth from './ContentWidth.astro';
import ExternalLink from './ExternalLink.astro';
import { siGithub, siAstro, siCreativecommons } from 'simple-icons';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const isImprintConfigured =
	import.meta.env.IMPRINT_NAME &&
	import.meta.env.IMPRINT_ADDRESS &&
	import.meta.env.IMPRINT_CITY;
---

<footer
	class="border-base-300 bg-base-200 text-base-content relative border-t p-6 text-base"
>
	<ContentWidth
		extraClasses="flex flex-col items-center gap-4 sm:flex-row sm:justify-between"
	>
		<nav class="flex items-center gap-6">
			<ExternalLink
				href="https://github.com/jamand"
				class="link flex items-center gap-1"
				showArrow={false}
			>
				<span
					class="inline-block h-5 w-5 fill-current"
					set:html={siGithub.svg}
				/>
				GitHub
			</ExternalLink>
			<ExternalLink
				href="https://linkedin.com/in/jer-amand"
				class="link"
				showArrow={false}>LinkedIn</ExternalLink
			>
			{
				isImprintConfigured ? (
					<a href={getLocalizedPath('/impressum/', lang)} class="link">
						{t('imprint.title')}
					</a>
				) : (
					false
				)
			}
		</nav>
		<div
			class="flex flex-col items-center gap-1 text-sm opacity-70 sm:items-end"
		>
			<aside class="inline-flex items-center gap-1">
				Built from scratch with
				<span
					class="inline-block h-3.5 w-3.5 fill-current"
					set:html={siAstro.svg}
				/>
				<ExternalLink href="https://astro.build" class="link" showArrow={false}
					>Astro</ExternalLink
				>
			</aside>
			<span class="inline-flex items-center gap-1">
				© {year} Jérémy Amand · Blog:
				<span
					class="inline-block h-3.5 w-3.5 fill-current"
					set:html={siCreativecommons.svg}
				/>
				<ExternalLink
					href="https://creativecommons.org/licenses/by/4.0/"
					class="link"
					showArrow={false}>CC BY 4.0</ExternalLink
				>
			</span>
		</div>
	</ContentWidth>
	<div class="rainbow-strip" aria-hidden="true">
		<span style="--c:#e40303"></span>
		<span style="--c:#ff8c00"></span>
		<span style="--c:#ffed00"></span>
		<span style="--c:#008026"></span>
		<span style="--c:#24408e"></span>
		<span style="--c:#732982"></span>
	</div>
</footer>

<style>
	.rainbow-strip {
		display: flex;
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
	}
	.rainbow-strip span {
		flex: 1;
		height: 3px;
		background: var(--c);
		transform-origin: bottom;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}
	.rainbow-strip:hover span {
		transform: scaleY(1.25);
	}
	.rainbow-strip span:hover {
		transform: scaleY(2);
		box-shadow: 0 0 14px var(--c);
	}
</style>
