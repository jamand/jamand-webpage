---
// External link component - adds ↗ indicator for links leaving the site

type Props = astroHTML.JSX.AnchorHTMLAttributes & {
	showArrow?: boolean;
};

const { showArrow = true, ...attrs } = Astro.props;
---

<a {...attrs}
	><slot />{
		showArrow && (
			<>
				{' '}
				<span aria-hidden="true">↗</span>
			</>
		)
	}</a
>
