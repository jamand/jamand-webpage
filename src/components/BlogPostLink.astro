---
// BlogPostLink component - displays a single blog post link in a list
import type { AvailableLanguage } from '../i18n/blog-utils';
import { getLangName, getDateLocale } from '../i18n/utils';
import type { Lang } from '../i18n/translations';

interface Props {
	title: string;
	url: string;
	pubDate: Date;
	lang: Lang; // Used for date formatting
	availableLanguages: AvailableLanguage[];
	isFallback?: boolean;
}

const {
	title,
	url,
	pubDate,
	lang,
	availableLanguages,
	isFallback = false,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString(getDateLocale(lang), {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});
---

<li
	class:list={[
		'hover:bg-base-200 list-none rounded-lg p-3 transition-colors',
		{ 'italic opacity-90': isFallback },
	]}
>
	<div class="flex items-center gap-3">
		<time
			datetime={pubDate.toISOString().split('T')[0]}
			class="shrink-0 text-sm tabular-nums opacity-60"
		>
			{formattedDate}
		</time>
		<a href={url} class="flex-1 font-medium no-underline hover:underline"
			>{title}</a
		>
		<span class="flex shrink-0 gap-1">
			{
				availableLanguages.map(({ lang: langCode, url: langUrl }) => (
					<a
						href={langUrl}
						aria-label={getLangName(langCode)}
						class="badge badge-outline badge-sm no-underline"
					>
						{langCode.toUpperCase()}
					</a>
				))
			}
		</span>
	</div>
</li>
