---
import { Briefcase, GraduationCap } from '@lucide/astro';

export interface TimelineEntry {
	type: 'work' | 'edu';
	period: string;
	title: string;
	org: string;
}

interface Props {
	entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<ul class="timeline timeline-vertical">
	{
		entries.map((item, i) => (
			<li class="min-h-[5rem]">
				{i > 0 && <hr />}
				{item.type === 'work' ? (
					<>
						<div class="timeline-start text-end text-sm opacity-60">
							{item.period}
						</div>
						<div class="timeline-middle">
							<Briefcase size={16} />
						</div>
						<div class="timeline-end timeline-box">
							<p class="font-semibold">{item.title}</p>
							<p class="text-sm opacity-70">{item.org}</p>
						</div>
					</>
				) : (
					<>
						<div class="timeline-start timeline-box text-end">
							<p class="font-semibold">{item.title}</p>
							<p class="text-sm opacity-70">{item.org}</p>
						</div>
						<div class="timeline-middle">
							<GraduationCap size={16} />
						</div>
						<div class="timeline-end text-sm opacity-60">{item.period}</div>
					</>
				)}
				{i < entries.length - 1 && <hr />}
			</li>
		))
	}
</ul>
