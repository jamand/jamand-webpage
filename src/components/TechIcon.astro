---
// Renders a Simple Icons SVG for a given technology name
import {
	siGo,
	siTypescript,
	siPython,
	siGnubash,
	siKubernetes,
	siDocker,
	siTerraform,
	siLinux,
	siGit,
} from 'simple-icons';
import type { SimpleIcon } from 'simple-icons';

interface Props {
	name: string;
	class?: string;
}

const iconMap: Record<string, SimpleIcon> = {
	Go: siGo,
	TypeScript: siTypescript,
	Python: siPython,
	Bash: siGnubash,
	Kubernetes: siKubernetes,
	Docker: siDocker,
	Terraform: siTerraform,
	Linux: siLinux,
	Git: siGit,
	CKA: siKubernetes,
	CKAD: siKubernetes,
};

const { name, class: className } = Astro.props;
const icon = iconMap[name];
---

{
	icon && (
		<span
			class:list={['tech-icon inline-block h-4 w-4 shrink-0', className]}
			set:html={icon.svg}
		/>
	)
}

<style>
	.tech-icon :global(svg) {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}
</style>
