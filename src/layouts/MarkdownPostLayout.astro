---
// Layout for individual blog posts rendered from markdown/mdx
import Layout from './Layout.astro';
import { defaultLang, type Lang } from '../i18n/translations';
import {
	useTranslations,
	getDateLocale,
	getLangFlag,
	getLangName,
} from '../i18n/utils';
import {
	getPostUrl,
	getPostUrlForLang,
	type BlogPost,
} from '../i18n/blog-utils';
import ContentImage from '../components/ContentImage.astro';
import FallbackNotice from '../components/FallbackNotice.astro';
import ShareLink from '../components/ShareLink.astro';

interface Props {
	frontmatter: BlogPost['data'];
	translation?: BlogPost;
	isFallback?: boolean;
	pageLang?: Lang;
	readingTime?: number;
	prevPost?: BlogPost;
	nextPost?: BlogPost;
}

const {
	frontmatter,
	translation,
	isFallback = false,
	pageLang,
	readingTime,
	prevPost,
	nextPost,
} = Astro.props;
const lang = pageLang || ((frontmatter.lang || defaultLang) as Lang);
const t = useTranslations(lang);
---

<Layout
	title={frontmatter.title}
	description={frontmatter.description}
	lang={lang}
	ogImage={frontmatter.image.src?.src ?? frontmatter.image.url}
	ogType="article"
>
	<article>
		{
			isFallback && pageLang && (
				<FallbackNotice
					pageLang={pageLang}
					contentLang={frontmatter.lang as Lang}
				/>
			)
		}
		<header
			class="not-prose mb-8 flex flex-wrap items-start justify-between gap-4"
		>
			<div class="min-w-0">
				<h1 class="m-0 text-3xl font-bold sm:text-4xl">{frontmatter.title}</h1>
				{
					readingTime && (
						<p class="mt-2 text-sm opacity-75">
							{t('blog.minRead').replace('{min}', String(readingTime))}
						</p>
					)
				}
			</div>
			<dl class="stats stats-horizontal shadow">
				<div class="stat px-4 py-2">
					<dt class="stat-title">{t('blog.publishedOn')}</dt>
					<dd class="stat-value text-base">
						<time datetime={frontmatter.pubDate.toISOString().split('T')[0]}>
							{
								frontmatter.pubDate.toLocaleDateString(getDateLocale(lang), {
									day: 'numeric',
									month: 'short',
									year: 'numeric',
								})
							}
						</time>
						{
							frontmatter.updatedAt && (
								<span class="block text-xs font-normal opacity-75">
									{t('blog.updatedAt')}{' '}
									<time
										datetime={frontmatter.updatedAt.toISOString().split('T')[0]}
									>
										{frontmatter.updatedAt.toLocaleDateString(
											getDateLocale(lang),
											{
												day: 'numeric',
												month: 'short',
												year: 'numeric',
											},
										)}
									</time>
								</span>
							)
						}
					</dd>
				</div>
				{
					translation && (
						<div class="stat px-4 py-2">
							<dt class="stat-title">{t('blog.availableIn')}</dt>
							<dd class="stat-value text-base">
								<a
									href={getPostUrl(translation)}
									class="text-2xl no-underline opacity-90 transition-opacity hover:opacity-100"
									title={getLangName(translation.data.lang as Lang)}
									aria-label={getLangName(translation.data.lang as Lang)}
								>
									{getLangFlag(translation.data.lang as Lang)}
								</a>
							</dd>
						</div>
					)
				}
			</dl>
		</header>

		<ContentImage
			src={frontmatter.image.src}
			url={frontmatter.image.url}
			alt={frontmatter.image.alt}
			class="mb-4 rounded-lg"
			width={400}
			caption={frontmatter.image.caption}
			author={frontmatter.image.author}
			authorUrl={frontmatter.image.authorUrl}
			lang={lang}
		/>
		<slot />

		<footer
			class="not-prose mt-6 flex flex-wrap items-center justify-between gap-4 pt-6"
		>
			<ShareLink url={Astro.url.href} title={frontmatter.title} lang={lang} />

			{
				(prevPost || nextPost) && (
					<nav class="flex gap-2" aria-label="Post navigation">
						{prevPost && (
							<a
								href={getPostUrlForLang(prevPost, lang)}
								class="btn btn-soft btn-sm"
							>
								&larr; {t('blog.previousPost')}
							</a>
						)}
						{nextPost && (
							<a
								href={getPostUrlForLang(nextPost, lang)}
								class="btn btn-soft btn-sm"
							>
								{t('blog.nextPost')} &rarr;
							</a>
						)}
					</nav>
				)
			}
		</footer>
	</article>
</Layout>
