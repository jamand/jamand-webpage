---
// Layout for individual project pages rendered from markdown/mdx
import Layout from './Layout.astro';
import { defaultLang, type Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';
import ContentImage from '../components/ContentImage.astro';
import FallbackNotice from '../components/FallbackNotice.astro';
import ExternalLink from '../components/ExternalLink.astro';
import type { CollectionEntry } from 'astro:content';

type ProjectData = CollectionEntry<'projects'>['data'];

interface Props {
	frontmatter: ProjectData;
	isFallback?: boolean;
	pageLang?: Lang;
}

const { frontmatter, isFallback = false, pageLang } = Astro.props;
const lang = pageLang || ((frontmatter.lang || defaultLang) as Lang);
const t = useTranslations(lang);

const statusStyles: Record<string, string> = {
	active: 'badge-success',
	completed: 'badge-info',
	'on-hold': 'badge-warning',
	planned: 'badge-neutral',
};
---

<Layout
	title={frontmatter.title}
	description={frontmatter.description}
	lang={lang}
	ogImage={frontmatter.image.src?.src ?? frontmatter.image.url}
	ogType="article"
>
	<article>
		{
			isFallback && pageLang && (
				<FallbackNotice
					pageLang={pageLang}
					contentLang={frontmatter.lang as Lang}
				/>
			)
		}
		<header class="not-prose mb-8">
			<div class="flex items-center gap-3">
				<h1 class="text-3xl font-bold sm:text-4xl">{frontmatter.title}</h1>
				<span class={`badge ${statusStyles[frontmatter.status]}`}>
					{
						t(
							`project.status.${frontmatter.status}` as `project.status.${typeof frontmatter.status}`,
						)
					}
				</span>
			</div>
			<p class="mt-2 opacity-80">{frontmatter.description}</p>
			<div class="mt-4 flex flex-wrap gap-2">
				{
					frontmatter.tags.map((tag) => (
						<span class="badge badge-outline">{tag}</span>
					))
				}
			</div>
			{
				frontmatter.url && (
					<ExternalLink href={frontmatter.url} class="link mt-4 inline-block">
						{t('project.viewOnGitHub')}
					</ExternalLink>
				)
			}
		</header>

		{
			!frontmatter.hideImage && (
				<ContentImage
					src={frontmatter.image.src}
					url={frontmatter.image.url}
					alt={frontmatter.image.alt}
					caption={frontmatter.image.caption}
					author={frontmatter.image.author}
					authorUrl={frontmatter.image.authorUrl}
					lang={lang}
					class="mb-8 rounded-lg"
				/>
			)
		}
		<slot />
	</article>
</Layout>
